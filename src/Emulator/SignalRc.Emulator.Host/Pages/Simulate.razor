@page "/simulate"
@using System.Net.WebSockets
@using System.Text
@using SignalRc.Models

<PageTitle>Simulate</PageTitle>

<h1>Simulate</h1>

<h2>Status</h2>
@if (_simulate)
{
    <button class="btn btn-primary" @onclick="StopSimulate">Stop simulate</button>
}
<p>
    @foreach (var s in (_statusList ?? Enumerable.Empty<string>()).Reverse())
    {
        @s<br/>
    }
</p>



<button class="btn btn-primary" @onclick="StartSimulate">Start simulate</button>

@code {
    private List<string> _statusList = new List<string>();
    private bool _simulate = false;
    private ClientWebSocket _client = new ClientWebSocket();
    @code {

        protected override async Task OnInitializedAsync()
        {
            await _client.ConnectAsync(new Uri("wss://localhost:7188/signalrc/stream"), CancellationToken.None);
            await InvokeAsync(StateHasChanged);
        }

        private void StopSimulate()
        {
            _simulate = false;
        }
        private async Task StartSimulate()
        {
            _simulate = true;
            var carId = Guid.NewGuid();
            var carId2 = Guid.NewGuid();
            var i = 0;
            while (_simulate)
            {
                i++;
                if (_statusList.Count() == 40)
                {
                    _statusList.Remove(_statusList.First());
                    _statusList.Remove(_statusList.First());
                }

                var rnd = new Random();
                var signalrc = new SignalRcModel
                {
                    Version = "1.0.0",
                    Type = "full",
                    Self = carId.ToString(),
                    Vehicles = new Dictionary<string, VehicleStateModel>()
                    {
                        {
                            carId.ToString(), new VehicleStateModel
                            {
                                Name = "Car 1",
                                Data = new DataModel
                                {
                                    Speed = new MetricWithUnitModel
                                    {
                                        Value = rnd.Next(10,84),
                                        Unit = "kmh"
                                        
                                    }
                                },
                                Position = new PositionModel
                                {
                                    X = rnd.Next(1,40),
                                    Y=rnd.Next(1,40),
                                    Z=rnd.Next(1,10),
                                }
                            }
                        }
                    }
                };
                var signalrc2 = new SignalRcModel
                {
                    Version = "1.0.0",
                    Type = "full",
                    Self = carId2.ToString(),
                    Vehicles = new Dictionary<string, VehicleStateModel>()
                    {
                        {
                            carId2.ToString(), new VehicleStateModel
                            {
                                Name = "Car 2",
                                Data = new DataModel
                                {
                                    Speed = new MetricWithUnitModel
                                    {
                                        Value = rnd.Next(10,84),
                                        Unit = "kmh"
                                        
                                    }
                                },
                                Position = new PositionModel
                                {
                                    X = rnd.Next(1,40),
                                    Y=rnd.Next(1,40),
                                    Z=rnd.Next(1,10),
                                }
                            }
                        }
                    }
                };
                await SendDataToSocket(signalrc);
                await SendDataToSocket(signalrc2);
                _statusList.Add(DateTime.UtcNow.ToString("s")+": Update car "+carId);
                _statusList.Add(DateTime.UtcNow.ToString("s")+": Update car "+carId2);
                await InvokeAsync(StateHasChanged);
                await Task.Delay(1000);
            }
           
            
        }

        private async Task SendDataToSocket(SignalRcModel model)
        {


            var json = System.Text.Json.JsonSerializer.Serialize(model);
            var bytes = Encoding.UTF8.GetBytes(json);

            await _client.SendAsync(bytes, WebSocketMessageType.Text, true, CancellationToken.None);
        }

    }

}
